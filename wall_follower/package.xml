<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wall_follower</name>
  <version>1.0.0</version>
  <description>Editable wall-following node for the ROS 2 hands-on lecture (F1TENTH).</description>
  <maintainer email="harun.teper@cs.tu-dortmund.de">Harun Teper</maintainer>
